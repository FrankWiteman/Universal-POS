<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" styleClass="root-dark"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.universalpos.terminal.controller.ReturnController">
    <padding><Insets topRightBottomLeft="24"/></padding>

    <Label text="↩ Return / Exchange" styleClass="panel-title"/>

    <!-- Step 1: Look up original transaction -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Receipt #" styleClass="form-label" minWidth="80"/>
        <TextField fx:id="receiptField"
                   promptText="Enter original receipt number (e.g. TXN-20260319-0042)"
                   HBox.hgrow="ALWAYS" styleClass="form-input"
                   onAction="#handleLookup"/>
        <Button text="Look Up" onAction="#handleLookup" styleClass="primary-button"/>
    </HBox>

    <!-- Original transaction summary -->
    <VBox fx:id="txnPanel" visible="false" managed="false" spacing="8"
          styleClass="summary-card">
        <padding><Insets topRightBottomLeft="14"/></padding>
        <Label fx:id="txnInfoLabel" text="" styleClass="card-title"/>
        <Label text="Select items to return:" styleClass="form-label"/>

        <TableView fx:id="itemsTable" prefHeight="240" styleClass="cart-table">
            <columns>
                <TableColumn fx:id="colReturn"   text="Return?" prefWidth="70"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colItemName" text="Product"  prefWidth="220"
                             style="-fx-alignment: CENTER-LEFT;"/>
                <TableColumn fx:id="colItemQty"  text="Qty Bought" prefWidth="90"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colReturnQty" text="Qty Return" prefWidth="90"
                             style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colRestock"  text="Restock?" prefWidth="80"
                             style="-fx-alignment: CENTER;"/>
            </columns>
        </TableView>

        <!-- Reason + refund method -->
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Reason" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   styleClass="form-label"/>
            <ComboBox fx:id="reasonCombo" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"
                      styleClass="form-input"/>

            <Label text="Refund via" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   styleClass="form-label"/>
            <ComboBox fx:id="refundMethodCombo" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"
                      styleClass="form-input"/>
        </GridPane>
    </VBox>

    <Label fx:id="errorLabel" text="" styleClass="error-label"
           visible="false" managed="false" wrapText="true"/>
    <Label fx:id="successLabel" text="" styleClass="success-label"
           visible="false" managed="false" wrapText="true"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="12">
        <Button text="Close" onAction="#handleClose"
                HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="secondary-button"/>
        <Button fx:id="processButton" text="Process Return" onAction="#handleProcessReturn"
                HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="checkout-button"
                visible="false" managed="false"/>
    </HBox>
</VBox>
